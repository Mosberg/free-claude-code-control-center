          "command": "fcc.models.copy",
          "when": "viewItem == model",
          "group": "inline"
        },
        {
          "command": "fcc.provider.openKeyPage",
          "when": "viewItem == provider",
          "group": "inline@1"
        },
        {
          "command": "fcc.provider.setCredential",
          "when": "viewItem == provider",
          "group": "inline@2"
        },
        {
          "command": "fcc.provider.copyModel",
          "when": "viewItem == provider",
          "group": "navigation@1"
        },
        {
          "command": "fcc.provider.clearCredential",
          "when": "viewItem == provider",
          "group": "navigation@2"
        },
        {
          "command": "fcc.agent.launch",
          "when": "viewItem == agent",
          "group": "inline"
        },
        {
          "command": "fcc.integration.installExtension",
          "when": "viewItem == integration-install",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Free Claude Code",
      "properties": {
        "fcc.server.command": {
          "type": "string",
          "default": "fcc-server",
          "markdownDescription": "Command used to start the FCC proxy. Use `uv run fcc-server` (with `fcc.server.cwd` set to a checkout) when running from source."
        },
        "fcc.server.cwd": {
          "type": "string",
          "default": "",
          "markdownDescription": "Working directory for the server process. Empty = your home directory."
        },
        "fcc.server.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra arguments appended to the server command."
        },
        "fcc.server.runIn": {
          "type": "string",
          "enum": [
            "background",
            "terminal"
          ],
          "default": "background",
          "markdownDescription": "`background`: managed child process with logs in the **Free Claude Code** output channel and automatic port detection. `terminal`: runs in a VS Code terminal (the upstream docs say to keep the terminal open)."
        },
        "fcc.server.host": {
          "type": "string",
          "default": "127.0.0.1",
          "markdownDescription": "Host the extension connects to. If you set it explicitly it is also passed to the server as `HOST` when started from VS Code."
        },
        "fcc.server.port": {
          "type": "number",
          "default": 8082,
          "markdownDescription": "Port the extension connects to (FCC default is `8082`). If you set it explicitly it is also passed to the server as `PORT` when started from VS Code. When the extension starts the server it auto-detects the port from the startup log."
        },
        "fcc.server.readFccEnvFile": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Best effort: read `PORT`, `HOST` and `ANTHROPIC_AUTH_TOKEN` from `~/.fcc/.env` (or `~/.config/free-claude-code/.env`) when they are not set in VS Code. Silently ignored if the files do not exist."
        },
        "fcc.server.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Start the FCC server automatically when VS Code starts (if it is not already running)."
        },
        "fcc.server.stopOnExit": {
          "type": "boolean",
          "default": true,
          "description": "Stop the server on VS Code exit if the extension started it."
        },
        "fcc.server.startTimeoutSeconds": {
          "type": "number",
          "default": 90,
          "minimum": 5,
          "description": "How long to wait for the server to become healthy after starting it."
        },
        "fcc.server.healthCheckIntervalSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "description": "How often to poll the server (GET /v1/models)."
        },
        "fcc.server.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Extra environment variables passed to the server when started from VS Code (for example `MODEL`, `MODEL_OPUS`, `LM_STUDIO_BASE_URL`). Do not put API keys here: use **FCC: Store Provider Credential Securely**. Values saved in the FCC Admin UI may take precedence, so the Admin UI stays the authoritative editor."
        },
        "fcc.auth.injectIntoServer": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also pass the stored proxy auth token to the server as `ANTHROPIC_AUTH_TOKEN` when starting it from VS Code."
        },
        "fcc.adminUi.path": {
          "type": "string",
          "default": "/admin",
          "description": "Path of the FCC Admin UI."
        },
        "fcc.adminUi.openIn": {
          "type": "string",
          "enum": [
            "simpleBrowser",
            "externalBrowser"
          ],
          "default": "externalBrowser",
          "description": "Where to open the Admin UI."
        },
        "fcc.agents.commands": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Override launcher commands by agent id: `claude`, `codex`, `pi`, `opencode`, `cline`, `hermes`, `dsh`, `grok`, `muse`, `aider`. Example: `{ \"claude\": \"uv run fcc-claude\" }`."
        },
        "fcc.agents.extraArgs": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {},
          "markdownDescription": "Extra CLI arguments by agent id. Example: `{ \"aider\": [\"--no-auto-commits\"] }`."
        },
        "fcc.agents.workingDirectory": {
          "type": "string",
          "enum": [
            "workspace",
            "activeFile",
            "prompt",
            "home"
          ],
          "default": "workspace",
          "description": "Working directory for launched agents."
        },
        "fcc.agents.terminalLocation": {
          "type": "string",
          "enum": [
            "panel",
            "editor"
          ],
          "default": "panel",
          "description": "Open agent terminals in the bottom panel or as editor tabs."
        },
        "fcc.terminal.injectEnv": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Add `ANTHROPIC_BASE_URL` and `ANTHROPIC_AUTH_TOKEN` to every new integrated terminal so any Anthropic-compatible client talks to FCC. Off by default because it breaks `claude` when the proxy is down."
        },
        "fcc.claudeCode.settingsScope": {
          "type": "string",
          "enum": [
            "user",
            "workspace"
          ],
          "default": "user",
          "description": "Where 'Point Claude Code for VS Code at FCC' writes claudeCode.environmentVariables."
        },
        "fcc.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the FCC status bar item."
        },
        "fcc.statusBar.alignment": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "right",
          "description": "Status bar alignment."
        },
        "fcc.install.voiceLocal": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Add the local Whisper option (`--voice-local` / `-VoiceLocal`) when running the installer or updater from VS Code."
        },
        "fcc.install.torchBackend": {
          "type": "string",
          "enum": [
            "",
            "cu130"
          ],
          "default": "",
          "markdownDescription": "Optional `--torch-backend` / `-TorchBackend` value for local Whisper (for example `cu130` for CUDA 13.0)."
        },
        "fcc.update.checkOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Check GitHub for a newer FCC release on startup and notify (no automatic install)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
