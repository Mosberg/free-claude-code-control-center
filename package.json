{
  "name": "free-claude-code-control-center",
  "displayName": "Free Claude Code (FCC) Control Center",
  "description": "Unofficial VS Code control center for Free Claude Code (FCC): start/stop the local proxy, open the Admin UI, launch all 10 coding agents, manage 61 providers, models, integrations, messaging, voice, updates and diagnostics.",
  "version": "0.1.0",
  "publisher": "mosberg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mosberg/free-claude-code-control-center.git"
  },
  "icon": "media/fcc-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "free claude code",
    "fcc",
    "claude code",
    "codex",
    "proxy",
    "nvidia nim",
    "openrouter",
    "ollama",
    "lm studio"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Launching the server, agents and installers runs commands on your machine, so these are disabled in untrusted workspaces."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fcc",
          "title": "Free Claude Code",
          "icon": "media/fcc-icon.svg"
        }
      ]
    },
    "views": {
      "fcc": [
        {
          "id": "fcc.status",
          "name": "Server",
          "icon": "media/icon/server.svg"
        },
        {
          "id": "fcc.agents",
          "name": "Coding Agents",
          "icon": "media/icon/agents.svg"
        },
        {
          "id": "fcc.models",
          "name": "Models",
          "icon": "media/icon/models.svg"
        },
        {
          "id": "fcc.providers",
          "name": "Providers (61)",
          "icon": "media/icon/providers.svg"
        },
        {
          "id": "fcc.integrations",
          "name": "Integrations",
          "icon": "media/icon/integrations.svg"
        },
        {
          "id": "fcc.messaging",
          "name": "Messaging & Voice",
          "icon": "media/icon/messaging.svg",
          "visibility": "collapsed"
        },
        {
          "id": "fcc.maintenance",
          "name": "Install, Update & Help",
          "icon": "media/icon/maintenance.svg",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "fcc.status",
        "when": "!fcc.cliFound",
        "contents": "The `fcc-server` command was not found on your PATH.\n[Install Free Claude Code](command:fcc.install)\n[Open the FCC repository](command:fcc.openRepo)\nInstalled somewhere custom? Point the extension at it with the `fcc.server.command` setting.\n[Open Settings](command:fcc.openSettings)"
      },
      {
        "view": "fcc.models",
        "when": "fcc.serverState == stopped",
        "contents": "The FCC server is not running, so no models can be listed.\n[Start Server](command:fcc.server.start)"
      }
    ],
    "walkthroughs": [
      {
        "id": "fcc.getStarted",
        "title": "Get started with Free Claude Code",
        "description": "Install FCC, start the proxy, add a provider key in the Admin UI and launch your first coding agent.",
        "steps": [
          {
            "id": "install",
            "title": "Install FCC",
            "description": "Runs the official FCC installer in a terminal after you confirm.\n[Install Free Claude Code](command:fcc.install)",
            "media": {
              "markdown": "media/walkthrough/1-install.md"
            },
            "completionEvents": [
              "onCommand:fcc.install"
            ]
          },
          {
            "id": "start",
            "title": "Start the FCC server",
            "description": "Start the local proxy from VS Code (or from the desktop launcher / tray icon).\n[Start Server](command:fcc.server.start)",
            "media": {
              "markdown": "media/walkthrough/2-start.md"
            },
            "completionEvents": [
              "onCommand:fcc.server.start"
            ]
          },
          {
            "id": "provider",
            "title": "Add a provider key and pick a model",
            "description": "Open the Admin UI, add a key (for example NVIDIA NIM), choose MODEL and click Apply.\n[Open Admin UI](command:fcc.server.openAdmin)",
            "media": {
              "markdown": "media/walkthrough/3-provider.md"
            },
            "completionEvents": [
              "onCommand:fcc.server.openAdmin"
            ]
          },
          {
            "id": "agent",
            "title": "Launch a coding agent",
            "description": "Claude Code, Codex, Pi, OpenCode, Cline, Hermes, DeepSeek Harness, Grok Build, Muse Code or Aider.\n[Launch an Agent](command:fcc.agent.pick)",
            "media": {
              "markdown": "media/walkthrough/4-agent.md"
            },
            "completionEvents": [
              "onCommand:fcc.agent.pick",
              "onCommand:fcc.agent.launch"
            ]
          }
        ]
      }
    ],
